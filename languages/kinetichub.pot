#: src/blocks/kinetic-box/index.js:345
msgid "Interactive Spotlight Glow"
msgstr ""

#: src/blocks/kinetic-box/index.js:348
msgid "Renders a radial flashlight effect that dynamically follows the cursor. Best used on dark backgrounds."
