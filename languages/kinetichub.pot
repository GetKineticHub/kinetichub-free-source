msgstr ""

#: src/blocks/kinetic-box/index.js:498
msgid "Zoom Inner Content"
msgstr ""

#: src/blocks/kinetic-box/index.js:498
msgid "Scales images on hover. It reaches only the direct children of the box, so an image sitting inside a nested group or column is not affected."
msgstr ""

#: src/blocks/kinetic-box/index.js:501
msgid "Zoom Intensity"
msgstr ""

