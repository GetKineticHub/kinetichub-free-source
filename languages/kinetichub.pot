msgstr ""

#: src/blocks/kinetic-marquee/index.js:291
msgid "Destination Link"
msgstr ""

#: src/blocks/kinetic-marquee/index.js:300
msgid "This item has a link but no image description. The frontend will fall back to the destination address for its accessible name."
msgstr ""

