#: src/blocks/kinetic-image-hero/index.js:1147
msgid "Overlap (%)"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1147
msgid "How far the second image reaches over the first. At 0 their edges just meet. Desktop only: mobile uses a fixed overlap."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1166
msgid "🎨 Appearance"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1168
msgid "Hero Min Height — Desktop (vh)"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1168
msgid "The least height the hero takes, as a percentage of the browser window: 100 is one full screen. It is a minimum, never a fixed height: content taller than this makes the hero taller."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1175
msgid "Hero Min Height — Mobile (vh)"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1183
msgid "The content sits beside the images in this presentation, never on them, so no overlay is drawn. The section background colour is set in the Styles tab."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1187
#: src/blocks/kinetic-image-hero/index.js:1189
#: src/components/OverlayControls.js:17
msgid "Overlay Color"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1190
msgid "The colour laid over the images, behind your content. It stays invisible until Overlay Opacity is above 0."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1198
msgid "Overlay Opacity"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1198
msgid "How strongly the colour covers the images. Raising it is the usual way to keep text readable over a busy image."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1212
msgid "Scene Backdrop"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1215
msgid "The image fills this presentation, so only Vignette, which lies over it, applies here: it shades the edges of the frame for a cinematic finish."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1224
msgid "Dual Glow, Accent Panel and Vignette scene backdrops. Vignette also shades the edges of a full-width image."
msgstr ""

#. translators: %s: scene backdrop name.
#: src/blocks/kinetic-image-hero/index.js:1231
#, js-format
msgid "%s is drawn behind a composition, and here the image covers that space, so it is not shown. The setting is kept for the composed presentations."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1239
msgid "Backdrop Intensity"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1239
msgid "How strong the scene backdrop is. Medium is the standard strength; Subtle and Strong adjust it without changing its shape."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1246
msgid "To let a background behind the hero show through (Hero Mesh, Ambient Aura or a Group), set Background in the Styles tab to a colour at 0% opacity. The scene backdrop still draws over it."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1250
msgid "🎬 Motion"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1252
msgid "Motion Mode"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1260
msgid "Motion Intensity"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1268
msgid "Reveal Style"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1268
msgid "How the images appear the first time the hero comes into view. The text is there from the start, and a hero already on screen when the page opens is never hidden."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1277
msgid "Stagger Images"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1277
msgid "Reveals the images one after another, primary first, a fraction of a second apart."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1285
msgid "Scroll motion, alone or with hover, a Strong intensity, Clip and Blur → Sharp image reveals, and staggered reveals that bring the images in one after another."
msgstr ""

#. translators: %s: comma-separated Smart Addon names.
#: src/blocks/kinetic-image-hero/index.js:1307
#, js-format
msgid "With Hover in Motion Mode: %s."
msgstr ""

#. translators: %s: comma-separated Smart Addon names.
#: src/blocks/kinetic-image-hero/index.js:1317
#, js-format
msgid "With Scroll in Motion Mode: %s."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1324
msgid "Smart Readability is offered where the text can sit on an image: on Single and Split Duo, and with Content Overlap."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1328
msgid "Depth and interaction addons: Pointer Depth and Reactive Spotlight follow the pointer, Depth on Scroll and Scroll Drift layer the scroll motion, Stack Fan opens a stack of cards, and Focus Reveal opens each photograph to its full frame."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1334
msgid "📐 Responsive"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1337
msgid "Mobile Composition"
msgstr ""

#. translators: %s: what Auto does for the current presentation.
#: src/blocks/kinetic-image-hero/index.js:1340
#, js-format
msgid "At 768px and below. Auto simplifies this presentation for small screens: %s. Stack places the images one under the other, straight. Primary Only shows just the first image."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1346
#: src/blocks/kinetic-magnetic-button/index.js:761
#: src/blocks/kinetic-video-modal/index.js:532
msgid "Auto"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1347
#: src/blocks/kinetic-magnetic-button/index.js:762
msgid "Stack"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1348
msgid "Primary Only"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1355
msgid "Mobile Order"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1355
msgid "On mobile the content and the images stack. Choose which comes first."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1358
msgid "Content First"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1359
msgid "Media First"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1366
msgid "A different mobile file for any image is set in the Images panel, under that image's settings."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1371
msgid "✍️ Content"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1372
msgid "Eyebrow, badge, heading, description and button text are edited directly on the canvas. Empty fields are left out on the site, with no gap where they would have been."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1374
#: src/blocks/kinetic-magnetic-button/index.js:729
msgid "Layout"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1377
#: src/blocks/kinetic-image-hero/index.js:1378
msgid "Horizontal placement"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1377
msgid "Left or Right puts the content on that side and the images on the other. Center puts the images below the content. The same choice is in the block toolbar."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1378
msgid "Where the content sits over the image, and how its lines align. The same choice is in the block toolbar."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1384
msgid "Vertical placement"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1394
msgid "Content Width"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1394
msgid "The widest the text may run. Narrow suits an editorial measure; Wide gives a large heading room on a full-width image. Custom sets it in pixels. The space the content has always caps it, so a width never pushes into the images."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1401
msgid "Custom Width (px)"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1413
msgid "Beside the images, the column is set by Content / Media in the Composition panel; Content Width caps the text inside that column."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1416
msgid "Spacing"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1416
msgid "The rhythm between the eyebrow, the heading, the description and the buttons, and between the two buttons. Balanced is the standard rhythm."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1423
msgid "Typography"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1425
msgid "Heading level"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1425
msgid "The heading's place in the page outline, for screen readers and search engines. It never changes the size. Use H1 only when this hero carries the page's main heading and the theme does not already print one above it."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1431
msgid "Heading Size"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1431
msgid "How large the heading is drawn, whatever its level. Large suits a longer headline; XL is the standard size; Display is poster-scale for a few words. Font and weight stay the theme's."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1437
msgid "Description Size"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1444
msgid "Eyebrow & Badge"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1446
msgid "Eyebrow Style"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1446
msgid "Plain is small capitals. Accent Line adds a short rule in the KineticHub accent colour on the outer side, or on both sides when the content is centred. Pill sets the eyebrow in a quiet capsule with an accent dot."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1452
msgid "Badge Style"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1452
msgid "Minimal is a hairline capsule. Soft is tinted with the accent colour. Glass is translucent and lightly blurred, for a badge over a photograph or a mesh."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1459
msgid "Surface & Readability"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1461
msgid "Content Surface"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1461
msgid "A visible panel behind the text, the width of the content. Soft Panel is a quiet, solid-feeling ground; Glass is translucent and blurs what lies behind it. Both take the tone opposite the text, so they read over a photograph, a mesh or a gradient."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1467
msgid "Smart Readability is on, so the panel deepens instead of the soft shade being drawn under it."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1470
msgid "With Content Overlap the panel takes the place of the solid plate, so the images run behind the panel."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1474
msgid "Entrance"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1476
msgid "Content Entrance"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1476
msgid "How the text arrives, in reading order: eyebrow, heading, description, then buttons. It plays once, as the page opens or when a hero further down comes into view, and ends on the hero exactly as it stands. Visitors whose device asks for reduced motion see the text at once."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1483
msgid "Timing"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1483
msgid "When the text starts, measured against the image reveal: together with it, just after, or once the images have mostly settled. Without an image reveal it is measured from when the hero comes into view."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1490
msgid "The editor shows the content at rest. The entrance plays on the published page."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1495
msgid "🔗 Buttons"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1496
msgid "Button text is edited on the canvas. A button appears on the site only once it has both text and a link."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1500
msgid "Layout & Hover"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1502
msgid "Size"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1502
msgid "One size for both buttons, so side by side they always share a height."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1508
msgid "Arrangement"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1508
msgid "Side by side, wrapping onto a new line when there is no room; or stacked, one above the other at the width of the wider button. They follow the content's alignment."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1514
#: src/blocks/kinetic-magnetic-button/index.js:758
msgid "On Mobile"
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1514
msgid "At 768px and below. Stacked puts the buttons one above the other; Stacked, full width also stretches them across the content."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1520
msgid "A restrained response to the pointer, and to keyboard focus: Lift raises the button a touch, Arrow Shift nudges its icon forward, Glow adds a soft halo in the accent colour. Mouse and trackpad only; reduced motion keeps Glow and drops the movement."
msgstr ""

#: src/blocks/kinetic-image-hero/index.js:1526
