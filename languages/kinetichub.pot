#: src/blocks/kinetic-magnetic-button/index.js:972
msgid "One colour drives several parts of every button. It fills a Solid button, tints a Soft one and colours its label; on an Outline button it becomes the border and the label instead. It is also the colour of the pulse ring, whatever the style."
msgstr ""

#: src/blocks/kinetic-magnetic-button/index.js:980
#: src/blocks/kinetic-scroll-divider/index.js:294
msgid "Text Color"
