msgstr ""

#: src/blocks/kinetic-marquee/index.js:310
msgid "Auto Motion"
msgstr ""

#: src/blocks/kinetic-marquee/index.js:310
msgid "Automatically move the marquee. A Pause/Resume control is shown while motion is enabled."
msgstr ""

#: src/blocks/kinetic-marquee/index.js:312
msgid "Base Speed (s)"
msgstr ""

#: src/blocks/kinetic-marquee/index.js:312
msgid "Seconds for one full pass of the track — lower is faster. It is a base rather than an exact time: the track scales with how many items are in the gallery, so adding images lengthens the pass at the same apparent speed."
msgstr ""

#: src/blocks/kinetic-marquee/index.js:313
msgid "Reverse Direction"
msgstr ""

#: src/blocks/kinetic-marquee/index.js:313
msgid "Runs the track left to right instead of right to left."
msgstr ""

#: src/blocks/kinetic-marquee/index.js:315
msgid "Pause on Hover / Tap"
msgstr ""

#: src/blocks/kinetic-marquee/index.js:315
msgid "Stops the track completely while the pointer is over it, so a visitor can read a logo. Turning this on switches Slow Down on Hover off — only one of the two can apply."
msgstr ""

#: src/blocks/kinetic-marquee/index.js:316
msgid "Slow Down on Hover"
msgstr ""

#: src/blocks/kinetic-marquee/index.js:316
msgid "Drops the track to a third of its speed while the pointer is over it, rather than stopping it dead. Turning this on switches Pause on Hover off — only one of the two can apply."
msgstr ""

#: src/blocks/kinetic-marquee/index.js:319
msgid "🎨 Visual Styling"
msgstr ""

#: src/blocks/kinetic-marquee/index.js:320
msgid "Logo Height (Desktop)"
msgstr ""

#: src/blocks/kinetic-marquee/index.js:320
msgid "Sets the height every item is scaled to, in pixels. Widths follow from each image, so logos of different proportions still line up along one row."
msgstr ""

#: src/blocks/kinetic-marquee/index.js:328
msgid "Finer control over the row — a separate item height for phones, a width cap so one wide logo cannot dominate, adjustable spacing between items, and grayscale or faded treatments that clear as an item is hovered."
msgstr ""

#: src/blocks/kinetic-marquee/index.js:332
msgid "Edge Fade Effect"
msgstr ""

#: src/blocks/kinetic-marquee/index.js:332
msgid "Fades the track out at its left and right edges, so items appear to drift in and out rather than being cut off at a hard line."
msgstr ""

#: src/blocks/kinetic-marquee/index.js:335
msgid "✨ Interaction & Focus"
msgstr ""

#: src/blocks/kinetic-marquee/index.js:336
msgid "Hover Lift Effect"
msgstr ""

#: src/blocks/kinetic-marquee/index.js:336
msgid "Raises the item under the pointer slightly above the row."
msgstr ""

#: src/blocks/kinetic-marquee/index.js:339
msgid "Sibling Focus Blur"
msgstr ""

#: src/blocks/kinetic-marquee/index.js:339
msgid "Blurs every other item while one is hovered, to single it out."
msgstr ""

#: src/blocks/kinetic-marquee/index.js:343
msgid "Warning: Using Sibling Blur without \"Pause on Hover\" makes it very difficult for users to track moving logos. Consider enabling Pause on Hover."
msgstr ""

#: src/blocks/kinetic-marquee/index.js:347
msgid "How strongly the other items are blurred."
msgstr ""

#: src/blocks/kinetic-marquee/index.js:350
msgid "Segmented Progress Rail"
msgstr ""

#: src/blocks/kinetic-marquee/index.js:350
msgid "A small bar with one segment per image you added, lighting up whichever is currently at the focus point. The repeated copies the loop is built from are not counted."
msgstr ""

#: src/blocks/kinetic-marquee/index.js:353
msgid "Rail Position"
msgstr ""

#: src/blocks/kinetic-marquee/index.js:353
msgid "Which edge of the marquee the segment bar sits against."
msgstr ""

#: src/blocks/kinetic-marquee/index.js:356
msgid "Pause / Slow State Indicator"
msgstr ""

#: src/blocks/kinetic-marquee/index.js:356
msgid "Prints a small RUNNING, PAUSED or SLOW badge on the marquee, so a visitor can see that their hover changed something. Only useful alongside Pause on Hover or Slow Down on Hover."
msgstr ""

#: src/blocks/kinetic-marquee/index.js:357
msgid "Active Center Highlight"
msgstr ""

#: src/blocks/kinetic-marquee/index.js:357
msgid "Enlarges whichever item is passing through the middle of the marquee, so the row has a focus point even when nobody is hovering it."
msgstr ""

#: src/blocks/kinetic-marquee/index.js:360
msgid "🖼️ Card Frames"
msgstr ""

#: src/blocks/kinetic-marquee/index.js:361
msgid "Enable Card Frame"
msgstr ""

#: src/blocks/kinetic-marquee/index.js:361
msgid "Puts each item on its own background card, which helps when the logos have mismatched backgrounds of their own."
msgstr ""

#: src/blocks/kinetic-marquee/index.js:364
msgid "Frame Background"
msgstr ""

#: src/blocks/kinetic-marquee/index.js:366
msgid "Corner Radius"
msgstr ""

#: src/blocks/kinetic-marquee/index.js:366
msgid "Rounds the corners of each card."
msgstr ""

#: src/blocks/kinetic-marquee/index.js:375
msgid "Four shadow depths for the cards, from a barely-there edge to a fully floating card."
msgstr ""

#: src/blocks/kinetic-marquee/index.js:388
msgid "Three more panels for the marquee as a whole — drop shadows behind it, an entrance animation as it scrolls into view, and per-device visibility for hiding it on phones or tablets."
msgstr ""

#: src/blocks/kinetic-marquee/index.js:426
