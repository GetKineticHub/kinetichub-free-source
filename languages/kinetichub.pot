msgstr ""

#: src/blocks/kinetic-marquee/index.js:260
msgid "Open links in New Tab"
msgstr ""

#: src/blocks/kinetic-marquee/index.js:260
msgid "Applies to every item that has a destination link. Items with no link stay unclickable either way."
msgstr ""

#: src/blocks/kinetic-marquee/index.js:282
msgid "Image description"
msgstr ""

#: src/blocks/kinetic-marquee/index.js:283
msgid "What a screen reader announces for this logo. It comes from the Media Library when you add the image — edit it here for different wording. Leave it blank only for a purely decorative logo. Items with a link should have one, so the link has a clear name."
