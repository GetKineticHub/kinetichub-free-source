#: src/components/MotionControls.js:41
msgid "Effect Intensity (Desktop)"
msgstr ""

#: src/blocks/kinetic-box/index.js:419
msgid "A single strength figure whose meaning follows the interaction type: for Lift it is the travel in pixels, for Scale and Tilt it is scaled down into a small growth or a few degrees of rotation. 0 leaves the box still."
msgstr ""

#: src/blocks/kinetic-box/index.js:420
#: src/components/MotionControls.js:50
msgid "Effect Intensity (Mobile)"
msgstr ""

#: src/blocks/kinetic-box/index.js:420
msgid "Replaces the desktop figure at 768px and under, for the same hover interaction."
msgstr ""

