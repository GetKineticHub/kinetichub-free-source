{
  "name": "kinetichub-suite",
  "version": "1.0.13",
  "description": "WordPress block suite with motion and interactive Gutenberg blocks.",
  "author": "kinetichub",
  "license": "GPL-2.0-or-later",
  "main": "build/index.js",
  "files": [
    "src",
    "assets",
    "languages",
    "includes",
    "kinetichub.php",
    "uninstall.php",
    "readme.txt",
    "changelog.txt",
    "license.txt",
    "webpack.config.js"
  ],
  "scripts": {
    "build": "wp-scripts build --webpack-src-dir=src --webpack-copy-php",
    "format": "wp-scripts format",
    "lint:css": "wp-scripts lint-style",
    "lint:js": "wp-scripts lint-js",
    "packages-update": "wp-scripts packages-update",
    "plugin-zip": "wp-scripts plugin-zip",
    "start": "wp-scripts start --webpack-src-dir=src --webpack-copy-php",
    "test": "jest"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.28.5",
    "@testing-library/dom": "^10.4.1",
    "@wordpress/scripts": "^31.5.0",
    "jest": "^30.3.0",
    "mini-css-extract-plugin": "^2.9.0"
  },
  "dependencies": {
    "@wordpress/components": "^32.2.0",
    "@wordpress/element": "^6.20.0"
  }
}
