{
  "apiVersion": 3,
  "name": "kinetichub/magnetic-button",
  "version": "1.0.12",
  "title": "Kinetic Magnetic Button",
  "category": "kinetic-suite",
  "description": "High-performance magnetic button with advanced hover physics, glassmorphism, and dynamic scaling.",
  "keywords": [
    "button",
    "magnetic",
    "interactive",
    "parallax",
    "call to action"
  ],
  "attributes": {
    "text": {
      "type": "string",
      "default": "Discover More"
    },
    "url": {
      "type": "string",
      "default": "#"
    },
    "openInNewTab": {
      "type": "boolean",
      "default": false
    },
    "linkRel": {
      "type": "string",
      "default": ""
    },
    "isOutline": {
      "type": "boolean",
      "default": false
    },
    "magneticStrength": {
      "type": "number",
      "default": 0.3
    },
    "magneticRange": {
      "type": "number",
      "default": 60
    },
    "textSeparation": {
      "type": "boolean",
      "default": true
    },
    "hoverScale": {
      "type": "boolean",
      "default": true
    },
    "enablePulse": {
      "type": "boolean",
      "default": false
    },
    "showIcon": {
      "type": "boolean",
      "default": false
    },
    "showIconNormal": {
      "type": "boolean",
      "default": false
    },
    "iconType": {
      "type": "string",
      "default": "arrow"
    },
    "iconPosition": {
      "type": "string",
      "default": "right"
    },
    "iconSize": {
      "type": "number",
      "default": 16
    },
    "mobileIconSize": {
      "type": "number"
    },
    "showStatusIndicator": {
      "type": "boolean",
      "default": false
    },
    "statusType": {
      "type": "string",
      "default": "dot"
    },
    "statusDotColor": {
      "type": "string"
    },
    "badgeText": {
      "type": "string",
      "default": "New"
    },
    "badgeTextColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "bgColor": {
      "type": "string"
    },
    "textColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "bgHoverColor": {
      "type": "string"
    },
    "textHoverColor": {
      "type": "string",
      "default": "#ffffff"
    },
    "glassmorphism": {
      "type": "boolean",
      "default": false
    },
    "borderWidth": {
      "type": "number",
      "default": 0
    },
    "borderColor": {
      "type": "string",
      "default": "transparent"
    },
    "borderHoverColor": {
      "type": "string",
      "default": "transparent"
    },
    "borderStyle": {
      "type": "string",
      "default": "solid"
    },
    "borderRadius": {
      "type": "number",
      "default": 50
    },
    "enableShadow": {
      "type": "boolean",
      "default": true
    },
    "shadowColor": {
      "type": "string",
      "default": "rgba(16, 185, 129, 0.4)"
    },
    "shadowX": {
      "type": "number",
      "default": 0
    },
    "shadowY": {
      "type": "number",
      "default": 8
    },
    "shadowBlur": {
      "type": "number",
      "default": 24
    },
    "shadowSpread": {
      "type": "number",
      "default": 0
    },
    "shadowHoverColor": {
      "type": "string",
      "default": "rgba(16, 185, 129, 0.6)"
    },
    "shadowHoverX": {
      "type": "number",
      "default": 0
    },
    "shadowHoverY": {
      "type": "number",
      "default": 15
    },
    "shadowHoverBlur": {
      "type": "number",
      "default": 30
    },
    "shadowHoverSpread": {
      "type": "number",
      "default": 0
    },
    "paddingV": {
      "type": "number",
      "default": 18
    },
    "paddingH": {
      "type": "number",
      "default": 40
    },
    "customFontSize": {
      "type": "number",
      "default": 16
    },
    "mobileFontSize": {
      "type": "number"
    },
    "align": {
      "type": "string",
      "default": "center"
    }
  },
  "supports": {
    "align": [
      "left",
      "center",
      "right"
    ],
    "spacing": {
      "margin": true,
      "padding": false
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "__experimentalFontFamily": true,
      "__experimentalFontWeight": true,
      "__experimentalFontStyle": true,
      "__experimentalTextTransform": true,
      "__experimentalLetterSpacing": true
    }
  },
  "textdomain": "kinetichub",
  "editorScript": "file:./index.js",
  "viewScript": "file:./view.js",
  "style": "file:./index.css",
  "editorStyle": "file:./index.css",
  "render": "file:./render.php"
}
