{
  "apiVersion": 3,
  "name": "kinetichub/cursor-reveal",
  "version": "1.0.12",
  "title": "Kinetic Cursor Reveal",
  "category": "kinetic-suite",
  "description": "Interactive list with floating media reveals and cursor-following previews.",
  "keywords": [
    "cursor reveal",
    "floating media",
    "physics-based"
  ],
  "attributes": {
    "blockId": {
      "type": "string",
      "default": ""
    },
    "items": {
      "type": "array",
      "default": [
        {
          "title": "Brand Identity",
          "subtitle": "Strategy & Logo",
          "mediaUrl": "",
          "url": ""
        },
        {
          "title": "Web Experience",
          "subtitle": "FSE Development",
          "mediaUrl": "",
          "url": ""
        }
      ]
    },
    "openInNewTab": {
      "type": "boolean",
      "default": false
    },
    "fontSize": {
      "type": "number",
      "default": 40
    },
    "mobileFontSize": {
      "type": "number",
      "default": 30
    },
    "subtitleColor": {
      "type": "string",
      "default": "#666666"
    },
    "subtitleSize": {
      "type": "number",
      "default": 13
    },
    "subtitleSpacing": {
      "type": "number",
      "default": 3
    },
    "mediaWidth": {
      "type": "number",
      "default": 350
    },
    "mediaRatio": {
      "type": "string",
      "default": "4/5"
    },
    "revealMask": {
      "type": "string",
      "default": "fade"
    },
    "hoverFilter": {
      "type": "string",
      "default": "none"
    },
    "itemGap": {
      "type": "number",
      "default": 50
    },
    "showItemBorder": {
      "type": "boolean",
      "default": true
    },
    "itemBorderColor": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "color": {
      "text": true,
      "background": true,
      "gradients": true
    },
    "typography": {
      "textAlign": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "textdomain": "kinetichub",
  "editorScript": "file:./index.js",
  "viewScript": "file:./view.js",
  "style": "file:./index.css",
  "editorStyle": "file:./index.css",
  "render": "file:./render.php"
}
