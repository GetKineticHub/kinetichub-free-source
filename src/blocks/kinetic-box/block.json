{
  "apiVersion": 3,
  "name": "kinetichub/kinetic-box",
  "version": "1.1.0",
  "title": "Kinetic Box",
  "category": "kinetic-suite",
  "description": "Structured container block with motion-ready layout and hover interaction controls.",
  "keywords": [
    "box",
    "container",
    "3D tilt",
    "magnetic hover",
    "glassmorphism",
    "parallax"
  ],
  "attributes": {
    "preset": {
      "type": "string",
      "default": "custom"
    },
    "animationType": {
      "type": "string",
      "default": "lift"
    },
    "transitionSpeed": {
      "type": "number",
      "default": 0.4
    },
    "bringToFront": {
      "type": "boolean",
      "default": false
    },
    "zoomImages": {
      "type": "boolean",
      "default": false
    },
    "zoomIntensity": {
      "type": "number",
      "default": 1.08
    },
    "hasGlow": {
      "type": "boolean",
      "default": false
    },
    "isGrayscale": {
      "type": "boolean",
      "default": false
    },
    "hoverIntensity": {
      "type": "number",
      "default": 20
    },
    "mobileIntensity": {
      "type": "number",
      "default": 0
    },
    "shadowSoftness": {
      "type": "number",
      "default": 20
    },
    "shadowOpacity": {
      "type": "number",
      "default": 0.1
    },
    "hoverShadowOpacity": {
      "type": "number",
      "default": 0.2
    },
    "shadowColor": {
      "type": "string",
      "default": "#000000"
    },
    "hoverShadowColor": {
      "type": "string",
      "default": "#000000"
    },
    "hoverBgColor": {
      "type": "string",
      "default": ""
    },
    "hoverBorderColor": {
      "type": "string",
      "default": ""
    },
    "minHeight": {
      "type": "number",
      "default": 0
    },
    "boxWidth": {
      "type": "number",
      "default": 0
    },
    "mobileBoxWidth": {
      "type": "number",
      "default": 0
    },
    "boxAlign": {
      "type": "string",
      "default": "center"
    },
    "hAlign": {
      "type": "string",
      "default": "left"
    },
    "vAlign": {
      "type": "string",
      "default": "top"
    },
    "url": {
      "type": "string",
      "default": ""
    },
    "linkLabel": {
      "type": "string",
      "default": ""
    },
    "openInNewTab": {
      "type": "boolean",
      "default": false
    },
    "linkRel": {
      "type": "string",
      "default": ""
    },
    "stretchedLink": {
      "type": "boolean",
      "default": false
    },
    "hideOnMobile": {
      "type": "boolean",
      "default": false
    },
    "hideOnDesktop": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "html": false,
    "anchor": true,
    "color": {
      "text": true,
      "background": true,
      "link": true,
      "gradients": true
    },
    "spacing": {
      "padding": true,
      "margin": true,
      "blockGap": true
    },
    "typography": {
      "fontSize": true,
      "lineHeight": true,
      "__experimentalFontFamily": true,
      "__experimentalFontWeight": true,
      "__experimentalFontStyle": true,
      "__experimentalTextTransform": true,
      "__experimentalLetterSpacing": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "width": true,
      "style": true
    }
  },
  "textdomain": "kinetichub",
  "editorScript": "file:./index.js",
  "style": "file:./index.css",
  "editorStyle": "file:./index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}